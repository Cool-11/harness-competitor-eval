# 录屏等大文件不进 git，网盘链接放 Log-analyse/*/recording.txt
*.mp4
*.mkv
*.avi
*.mov
*.webm

# 敏感信息绝不入库
*.env
*.key
*_credentials*
secrets/

# 系统/编辑器杂项
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.venv/

# 本地草稿（不想公开的工作文件）
_local/

# 工作区记忆（含个人身份/简历等敏感信息，公开仓库绝不入库）
.workbuddy/

# 整理前快照留档（历史副本，仅本地）
_archive/

# 环境冻结备份（个人技能/配置，仅本地留档，绝不入库）
Log-analyse/baseline/_backup/
