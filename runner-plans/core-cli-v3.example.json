{
  "schema_version": 1,
  "batch_id": "core-cli-v3-example-v2",
  "root": "C:/tmp_run",
  "variant": "cli-product-default-v3",
  "comparison_track": "B_native_product",
  "defaults": {
    "timeout_seconds": 1800,
    "tools": "shell,filesystem",
    "permissions": "workspace-write"
  },
  "adapters": {
    "codex": {
      "executable": "codex",
      "sandbox": "workspace-write",
      "extra_args": []
    },
    "dsh": {
      "executable": "dsh",
      "profile": "headless",
      "extra_args": []
    }
  },
  "slots": [
    {
      "case": "S06",
      "product": "codex",
      "run": "auto"
    },
    {
      "case": "S06",
      "product": "dsh",
      "run": "auto"
    },
    {
      "case": "S11",
      "product": "codex",
      "run": "auto"
    },
    {
      "case": "S11",
      "product": "dsh",
      "run": "auto"
    }
  ]
}
