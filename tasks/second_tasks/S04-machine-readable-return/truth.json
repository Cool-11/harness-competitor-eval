{
  "输入": "inputs/data.csv",
  "原始数据行数": 5,
  "变更": {"去重": 1, "补缺": 2, "日期": 2},
  "说明": {
    "去重": "第 4 行与第 1 行完全相同，删除 1 行",
    "补缺": "第 2 行、第 5 行 qty 缺失 → 0，共 2 处",
    "日期": "第 3 行 2026/9/7 → 2026-09-07；第 5 行 9月10日 → 2026-09-10，共 2 行"
  },
  "schema": {"changes": [{"type": "<去重|补缺|日期>", "count": "<整数>"}]}
}
